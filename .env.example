# SagarManthan environment variables (placeholders only — never commit real secrets)

# Frontend origin for CORS (comma-separated). Local default is fine for demo.
FRONTEND_ORIGIN=http://localhost:5173

# Data mode label
DATA_MODE=DEMO
DEMO_MODE=true
DATA_RANDOM_SEED=42

# Freight data provider: synthetic | csv | external
FREIGHT_DATA_PROVIDER=synthetic

# Economics (demo defaults)
BUNKER_PRICE_USD_MT=520.0
USD_INR_RATE=83.50

# Route behaviour — keep false so unsupported routes fail safely
ALLOW_ESTIMATED_DISTANCE=false
ESTIMATED_DISTANCE_NM=4500.0

# Transparent cost proxies
DEADHEAD_COST_USD_PER_NM=0.15
BALLAST_FACTOR=0.85
HANDLING_HIRE_FRACTION=0.30
DEMURRAGE_WAITING_FRACTION=0.35

# Backend
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ---- Frontend (Vite) ----
# Copy these into frontend/.env or root .env as needed
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_PROVIDER=osm
# For MapTiler (optional):
# VITE_MAP_PROVIDER=maptiler
# VITE_MAPTILER_API_KEY=
# For Mapbox (optional):
# VITE_MAP_PROVIDER=mapbox
# VITE_MAPBOX_ACCESS_TOKEN=
